# WebSocket URL of the remote-mode server (examples/remote/server).
VITE_AI_REMOTE_URL=ws://localhost:8080/ai-agent

# Provider / model the client element advertises. The server pins these
# when AI_PROVIDER / AI_MODEL are set in its own .env.
VITE_AI_PROVIDER=openai
VITE_AI_MODEL=gpt-4o-mini

# Note: there is intentionally no API key here. In remote mode the provider
# key lives only on the server — see examples/remote/server/.env.
