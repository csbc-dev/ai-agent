# Provider the server uses: openai | anthropic | azure-openai | google
AI_PROVIDER=openai

# Model the server pins for every request. When set, clients cannot pick a
# different (e.g. costlier) model — the server is the last line of defense
# for cost and quota control.
AI_MODEL=gpt-4o-mini

# Provider API endpoint. Leave empty to use the provider default.
#   OpenAI:    https://api.openai.com  (default when empty)
#   Anthropic: https://api.anthropic.com
#   Ollama:    http://localhost:11434   (no /v1 suffix; the library appends /v1/chat/completions)
# For official OpenAI keep this EMPTY: setting it explicitly makes the
# `stream_options` heuristic omit `include_usage`, so streamed `usage` is
# silently dropped and the client's usage panel stays blank.
AI_BASE_URL=

# Provider API key. This is the whole point of remote mode: the key stays
# in the server environment and is never sent to the browser. Not needed
# for a local model server such as Ollama.
AI_API_KEY=

# Optional system prompt applied to every conversation.
AI_SYSTEM=You are a concise, helpful assistant.

# WebSocket port. Clients connect to ws://localhost:${PORT}/ai-agent
PORT=8080
