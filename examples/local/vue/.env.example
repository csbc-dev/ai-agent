# Provider: openai | anthropic | azure-openai | google
VITE_AI_PROVIDER=openai
# The model must match VITE_AI_BASE_URL. The default base-url below is a local
# Ollama server, so the default model is an Ollama tag (`ollama pull gemma3:4b`).
# Switch to e.g. gpt-4o-mini when you point base-url at OpenAI / a proxy.
VITE_AI_MODEL=gemma3:4b

# API endpoint. Point this at your own backend proxy in production
# (the proxy injects the provider key server-side). For local development
# you can point directly at a provider or a local model server.
#   Ollama:    http://localhost:11434      (default below — note: no /v1 suffix; the
#                                           library appends /v1/chat/completions itself)
#   OpenAI:    (leave EMPTY)               official OpenAI — see note below
#   Anthropic: https://api.anthropic.com   (pair with e.g. claude-sonnet-4-20250514)
# For official OpenAI, leave this EMPTY: the default endpoint is used AND streaming
# `usage` is included. Setting an explicit base-url (even https://api.openai.com)
# makes the `stream_options` heuristic omit usage, so the usage panel stays blank
# unless the element also gets `stream-options="always"` (not wired in this example).
VITE_AI_BASE_URL=http://localhost:11434

# Dev-only. Exposes the key in the DOM / network panel — never ship this.
# Leave empty when base-url is a proxy or a local model server.
VITE_AI_API_KEY=

# Optional system prompt.
VITE_AI_SYSTEM=You are a concise, helpful assistant.
