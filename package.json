{
  "name": "@csbc-dev/ai-agent",
  "version": "0.4.0",
  "description": "Declarative AI inference component for Web Components. Streaming-first, multi-provider (OpenAI, Anthropic, Azure OpenAI, Google Gemini) via wc-bindable-protocol.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./src/auto/auto.d.ts",
      "default": "./src/auto/auto.min.js"
    },
    "./auto/remoteEnv": {
      "types": "./src/auto/remoteEnv.d.ts",
      "default": "./src/auto/remoteEnv.min.js"
    }
  },
  "files": [
    "dist",
    "src/auto/*.min.js",
    "src/auto/*.d.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run __tests__",
    "test:watch": "vitest __tests__",
    "test:coverage": "vitest run __tests__ --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.include=src/**/*.ts --coverage.exclude=src/types.ts --coverage.exclude=src/index.ts --coverage.exclude=src/debug.ts --coverage.exclude=src/auto/**/*.d.ts",
    "test:integration": "npm run build && playwright test"
  },
  "keywords": [
    "web-components",
    "ai",
    "llm",
    "openai",
    "anthropic",
    "azure-openai",
    "google",
    "gemini",
    "streaming",
    "custom-elements",
    "wc-bindable",
    "declarative",
    "no-provider-sdk",
    "framework-agnostic"
  ],
  "dependencies": {
    "@wc-bindable/core": "^0.4.0",
    "@wc-bindable/remote": "^0.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.4",
    "happy-dom": "^20.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "ws": "^8.20.0"
  },
  "author": "mogera551",
  "repository": {
    "type": "git",
    "url": "https://github.com/csbc-dev/ai-agent.git"
  },
  "license": "MIT"
}
